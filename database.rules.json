{
  "rules": {
    "watchGroups": {
      "$groupId": {
        ".read": "$groupId.matches('^group-[a-zA-Z0-9_-]{3,64}$')",
        "messages": {
          "$messageId": {
            ".write": "newData.child('senderId').val() === 'dinu' || newData.child('senderId').val() === 'kanmani'",
            ".validate": "newData.hasChildren(['senderId', 'senderName', 'text', 'timestamp']) && newData.child('text').val().length <= 1000 && (!newData.hasChild('gifUrl') || newData.child('gifUrl').val().matches('^https://.*'))"
          }
        },
        "presence": {
          "$userId": {
            ".write": "$userId === 'dinu' || $userId === 'kanmani'",
            ".validate": "newData.val() === 'Online' || newData.val() === 'Watching' || newData.val() === 'Paused' || newData.val() === 'Buffering' || newData.val() === 'Offline'"
          }
        },
        "typing": {
          "$userId": {
            ".write": "$userId === 'dinu' || $userId === 'kanmani'",
            ".validate": "newData.isBoolean()"
          }
        }
      }
    }
  }
}
