# ==============================================================================
# DinuStream Environment Variables Template
# Copy this file to .env.local and populate with your private credentials.
# NEVER commit .env.local or any real credentials to version control!
# ==============================================================================

# ==============================================================================
# 1. SERVER-SIDE ONLY (CONFIDENTIAL - NEVER EXPOSE TO CLIENT OR BROWSER)
# ==============================================================================

# DinuStream Sync Manager API (Private Oracle Cloud Compute)
# Known development configuration is on port 8787 (127.0.0.1:8787)
# Oracle Cloud production: http://your-oracle-server-ip:8787
SYNC_MANAGER_API_URL=http://127.0.0.1:8787
SYNC_MANAGER_API_KEY=

# DinuStream Jellyfin Media Server (Private Oracle Cloud Compute)
# Routed through Next.js proxy (/api/jellyfin) to keep API keys server-side only
JELLYFIN_SERVER_URL=http://127.0.0.1:8096
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=

# Master Admin PIN (Used for server-side verification of admin access)
ADMIN_MASTER_PIN=1337

# ==============================================================================
# 2. CLIENT-SAFE CONFIGURATION (PREFIXED WITH NEXT_PUBLIC_)
# ==============================================================================

# Internal Proxy Base URLs (The browser accesses these local endpoints)
NEXT_PUBLIC_SYNC_MANAGER_BASE_URL=/api/sync
NEXT_PUBLIC_JELLYFIN_PROXY_URL=/api/jellyfin

# DinuStream Firebase Configuration (For Watch Together chat & presence only)
# These public web credentials identify the Firebase project in client browsers
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
