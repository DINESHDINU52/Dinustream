# Local development environment (copy to .env.local for `npm run dev`).
#
# DEMO_MODE=1 -> use the in-memory mock catalog, no backend needed.
# DEMO_MODE=0 -> talk to a real Jellyfin server.

# Same-origin proxy path the browser uses (the Next.js route handler at
# app/jellyfin/[...path] forwards this to JELLYFIN_SERVER_URL in dev).
NEXT_PUBLIC_JELLYFIN_URL=/jellyfin

# Where the Next.js server-side proxy actually forwards to in dev.
# Point this at your Jellyfin instance (e.g. the Oracle VM over an SSH tunnel).
JELLYFIN_SERVER_URL=http://127.0.0.1:8096

# 1 = mock data (no backend). Set 0 once Jellyfin is reachable.
NEXT_PUBLIC_DEMO_MODE=0

# Optional: Python Sync Manager for the cache-first playback flow.
NEXT_PUBLIC_SYNC_MANAGER_URL=/api/sync
SYNC_MANAGER_URL=http://127.0.0.1:8787

# Optional: Jellyfin library (folder) that holds the Dolby ad clips shown while
# a new movie is copied from Drive to SSD. Point at the FOLDER, never a file —
# clips can be added/renamed/removed freely. Defaults to "Dolby".
NEXT_PUBLIC_DOLBY_ADS_LIBRARY=Dolby
